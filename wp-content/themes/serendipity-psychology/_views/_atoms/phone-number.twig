<span class="flex items-center text-sm lg:text-base xl:text-lg {{ phone_classes }}">
    {{ fn('icon','phone','mr-1 ' ~ ('text-white' in phone_classes ? 'text-white' : 'text-primary')) }}
    <a href="tel:{{ options.default_phone_number }}" class="xl:ml-1 hover:underline font-bold {{ 'text-white' in phone_classes ? 'text-white' : 'text-primary' }}">{{ options.default_phone_number }}</a>
</span>