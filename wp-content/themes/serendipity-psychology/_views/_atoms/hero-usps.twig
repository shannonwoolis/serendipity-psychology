<div class="w-full bg-primary rounded-tr-4xl lg:rounded-tr-5xl">
    <div class="{{ spacingY }} {{ spacingX }}">
        <div class="flex flex-wrap -m-4 lg:pr-16">
            {% for item in usps %}
                <div class="w-full flex px-4 py-2 md:py-4 {{ usp_classes }}">
                    {% if item.icon %}<img src="{{ item.icon.url|resize(100) }}" class="w-12 h-12 object-contain mb-3">{% endif %}
                    <div class="flex flex-col">
                        {% if item.title %}<span class="text-xs mb-1 font-bold text-white leading-tight font-heading pr-2">{{ item.title }}</span>{% endif %}
                        {% if item.text %}<span class="text-lg text-secondary leading-tight font-heading pr-2">{{ item.text }}</span>{% endif %}
                    </div>
                </div>
            {% endfor %}
        </div>
    </div>
</div>