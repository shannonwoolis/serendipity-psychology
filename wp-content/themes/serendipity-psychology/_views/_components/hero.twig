<div class="w-full hero bg-grey">
	<div class="max-w-screen-4xl mx-auto flex flex-wrap relative">
		<div class="w-full lg:w-1/2">
			{% include "_atoms/hero-image.twig" with { classes: 'lg:hidden lg:h-full' } %}

			<div class="flex flex-col {{ spacingY }} {{ spacingX }}">
				{% if not fn('is_front_page') %}{% filter shortcodes %}<span class="mb-4">[wpseo_breadcrumb]</span>{% endfilter %}{% endif %}
				{% if pre_title %}<span class="mb-2 font-subheading pre-title text-primary text-balance">{{ pre_title }}</span>{% endif %}
				{% if title %}
					{% if h1 %}
						<h1 class="font-heading mb-0 leading-tight text-balance {{ fn('is_front_page') ? 'text-4xl xs:text-5xl xl:text-6xl 3xl:text-7xl 2xl:pr-16' : 'text-3xl sm:text-4xl lg:text-5xl xl:text-6xl' }}">{{ title }}</h1>
					{% else %}
						<span class="font-heading mb-0 leading-tight text-balance {{ fn('is_front_page') ? 'text-4xl xs:text-5xl xl:text-6xl 3xl:text-7xl 2xl:pr-16' : 'text-3xl sm:text-4xl lg:text-5xl xl:text-6xl' }}">{{ title }}</span>
					{% endif %}
				{% endif %}
				{% if copy %}<span class="copy -mb-6 mt-4">{{ copy }}</span>{% endif %}
				{% if buttons or show_phone_number %}
					<div class="flex flex-wrap items-center mt-4">
						{% for button in buttons %}
							{% include "_atoms/button.twig" with {
								link: button.button.url,
								text: button.button.title,
								colour: button.colour,
								classes: 'mt-2 ' ~ (loop.last and show_phone_number ? 'mr-6' : 'mr-2'),
							} %}
						{% endfor %}
						{% if show_phone_number %}
							{% include "_atoms/phone-number.twig" with {
								phone_classes: 'mt-2'
							} %}
						{% endif %}
					</div>
				{% endif %}
			</div>

			{% if usps and show_insurance_providers %}
				{% include "_atoms/hero-usps.twig" with {
					usp_classes: 'sm:w-1/2 flex-col'
				} %}
			{% endif %}
		</div>
		<div class="top-0 right-0 w-full lg:w-1/2 relative {% if usps %}{{ show_insurance_providers ? 'lg:pb-32' : 'lg:pb-16 2xl:pb-20' }}{% endif %}">
			{% include "_atoms/hero-image.twig" with { classes: 'hidden lg:block lg:h-full' } %}

			{% if show_insurance_providers %}
				<div class="py-8 lg:py-0 lg:absolute lg:left-0 lg:bottom-6 w-full flex flex-wrap xl:flex-nowrap justify-between items-center {{ spacingX }}">
					<span class="font-heading text-primary leading-tight mb-2 xl:mb-0">
						Insurance <br class="hidden xl:block">Providers
					</span>
					<div class="-mx-2 xl:ml-8 xl:mr-0 w-full flex flex-wrap xs:justify-between items-center md:flex-nowrap">
						{% include "_atoms/logos.twig" %}
					</div>
				</div>
			{% endif %}
		</div>
		{% if usps and not show_insurance_providers %}
			{% include "_atoms/hero-usps.twig" with {
				usp_classes: 'sm:w-1/2 lg:w-1/4 flex-row items-center gap-x-4'
			} %}
		{% endif %}
	</div>
</div>
