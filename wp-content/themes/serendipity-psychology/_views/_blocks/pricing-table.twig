<div class="container flex justify-center {{ section.padding_top ? spacingT }} {{ section.padding_bottom ? spacingB }}">
    <div class="relative flex flex-wrap {{ section.image ? 'justify-start' : 'justify-center' }} max-w-screen-lg rounded-tr-3xl overflow-hidden">
        {# <div class="block bg-{{ backgroundColour ? backgroundColour : 'secondary-pale' }} w-screen h-2 absolute left-1/2 -translate-x-1/2 top-1/2 -translate-y-1/2 z-0"></div> #}
        <div class="relative z-10 {{ section.image ? 'w-full sm:w-2/3' }} p-6 md:p-10 bg-{{ backgroundColour ? backgroundColour : 'primary-pale' }} flex flex-col relative">
            {% if section.pre_title %}<span class="mb-2 font-subheading text-2xl md:text-3xl text-primary">{{ section.pre_title }}</span>{% endif %}
            {% if section.title %}<span class="font-heading text-2xl md:text-3xl leading-tight mb-4 {{ section.copy and not section.pre_title ? 'text-primary' }}">{{ section.title }}</span>{% endif %}

            {% if section.prices %}
                {% for price in section.prices %}
                    <div class="flex {{ section.copy ? 'mb-4' }} flex-col sm:flex-row gap-y-2 gap-x-4 justify-between sm:items-end pb-4 border-b border-primary/50">
                        <span class="font-heading text-lg md:text-xl leading-tight">{{ price.item }}</span>
                        <span class="font-heading text-lg md:text-xl leading-tight">{{ price.price }}</span>
                    </div>
                {% endfor %}
            {% endif %}

            {% if section.copy %}<div class="copy -mb-6">{{ section.copy }}</div>{% endif %}
        </div>
    </div>
</div>