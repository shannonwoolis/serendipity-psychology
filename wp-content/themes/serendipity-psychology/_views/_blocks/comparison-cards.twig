<section class="{{ section.padding_top ? spacingT }} {{ section.padding_bottom ? spacingB }} bg-{{ section.background_colour ? section.background_colour : 'white' }} {{ 'dark' in section.background_colour ? 'text-white' }}">
    <div class="container">
        <div class="flex flex-wrap">
            <div class="w-full">
                <div class="copy">
                    {% if section.title %}<h2>{{ section.title }}</h2>{% endif %}
                    {% if section.copy %}{{ section.copy }}{% endif %}
                </div>
                {% if section.comparison_cards %}
                    <div class="flex flex-wrap justify-center -m-2 {{ section.buttons or section.sidebar ? 'mt-10' : 'mt-2' }}">
                        {% for card in section.comparison_cards %}
                            <div class="w-full sm:w-1/2 md:w-1/3 p-2">
                                <div class="w-full h-full p-6 md:p-10 flex flex-col items-start bg-primary-dark text-white">
                                    <span class="mb-2 font-subheading text-xl md:text-2xl text-secondary">{{ card.number }}. {{ card.pre_title }}</span>
                                    <span class="text-2xl md:text-3xl mb-2 leading-tight">{{ card.title }}</span>
                                    <span class="copy dark-copy font-light">{{ card.copy }}</span>

                                    <span class="mt-auto font-semibold mb-2">{{ card.percentage_name }}</span>
                                    <span class="relative bg-white w-full h-3 block">
                                        <span class="absolute top-0 left-0 h-full bg-secondary-dark" style="width: {{ card.percentage }}%"></span>
                                    </span>
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                {% endif %}
                {% if section.copy_after %}<div class="mt-10 copy">{{ section.copy_after }}</div>{% endif %}
            </div>
        </div>
    </div>
</section>