<section class="{{ section.no_top_padding ? '' : spacingT }} {{ spacingB }} bg-{{ section.background_colour ? section.background_colour : 'white' }} {{ 'dark' in section.background_colour ? 'text-white' }}">
    <div class="container">
        {% for row in section.copy_rows %}
            {% set even = loop.index is even %}
            <div class="flex flex-wrap {{ even ? 'lg:flex-row-reverse' : 'lg:flex-row' }} {{ row.vertically_center_columns ? 'items-center' }} {{ row.increased_horizontal_padding ? 'lg:max-w-screen-xl lg:mx-auto' }}">
                <div class="w-full {{ row.equal_width_columns ? 'lg:w-1/2' : 'lg:w-3/5' }} lg:pr-8">
                    <div class="copy">
                        {% if row.h1 %}<h1>{{ row.h1 }}</h1>{% endif %}
                        {{ row.copy }}
                    </div>
                    {% if row.buttons %}
                        <div class="flex flex-wrap mt-4">
                            {% for button in row.buttons %}
                                {% include "_atoms/button.twig" with {
                                    link: button.button.url,
                                    text: button.button.title,
                                    colour: button.colour,
                                    classes: 'mt-2 mr-2',
                                } %}
                            {% endfor %}
                        </div>
                    {% endif %}
                </div>

                <div class="w-full mt-8 lg:mt-0 {{ row.equal_width_columns ? 'lg:w-1/2' : 'lg:w-2/5' }} lg:pl-8">
                    <div class="grid grid-cols-1 {{ row.sidebar|length > 1 ? 'sm:grid-cols-2' }} lg:grid-cols-1 gap-6 md:gap-8">
                        {% for side in row.sidebar %}
                            {% include "_sidebar/"~side.acf_fc_layout|replace({"_":"-"})~".twig" %}
                        {% endfor %}
                    </div>
                </div>
            </div>
            {% if row.bottom_cards %}
                <div class="flex flex-wrap justify-center -m-2 {{ row.buttons or row.sidebar ? 'mt-10' : 'mt-2' }}">
                    {% if row.bottom_cards_title %}<h3 class="w-full block mb-4 pl-2 text-primary">{{ row.bottom_cards_title }}</h3>{% endif %}
                    {% for card in row.bottom_cards %}
                        <div class="w-full sm:w-1/2 md:w-1/3 p-2">
                            <div class="w-full h-full p-6 md:p-10 flex flex-col items-start bg-{{ 'dark' in section.background_colour ? 'primary text-white' : 'primary-pale text-primary' }}">
                                <span class="text-xl md:text-2xl mb-2">{{ card.title }}</span>
                                <span class="font-light card-copy">{{ card.copy }}</span>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            {% endif %}
        {% endfor %}
    </div>
</section>