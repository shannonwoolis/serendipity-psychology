{% set backgroundColour = section.background_colour|default('secondary-pale') %}
<div class="{{ section.padding_top ? spacingT }} {{ section.padding_bottom ? spacingB }} {% if section.full_width %}bg-{{ backgroundColour ? backgroundColour : 'secondary-pale' }}{% endif %}">
    <div class="container flex justify-center">
        <div class="relative flex flex-col overflow-hidden {{ not section.full_width ? 'max-w-screen-xl rounded-tr-3xl' }}">
            {% if section.above_title %}<h2 class="w-full mb-6">{{ section.above_title }}</h2>{% endif %}
            <div class="relative z-10 flex flex-col {% if not section.full_width %}p-6 md:p-10 bg-{{ backgroundColour ? backgroundColour : 'secondary-pale' }}{% endif %}">
                {% if section.pre_title %}<span class="mb-2 font-subheading text-2xl md:text-3xl text-primary">{{ section.pre_title }}</span>{% endif %}
                {% if section.title %}<span class="font-heading text-2xl md:text-3xl mb-2 leading-tight {{ section.copy and not section.pre_title ? 'text-primary' }}">{{ section.title }}</span>{% endif %}
                {% if section.copy %}<span class="">{{ section.copy }}</span>{% endif %}
                {% if section.usps %}
                    <div class="flex flex-wrap justify-center -m-2 mt-4">
                        {% for item in section.usps %}
                            <div class="w-full p-2 flex-grow {{ section.process|length is odd ? 'sm:w-1/2 md:w-1/3 xl:w-1/5' : 'sm:w-1/2 lg:w-1/4' }}">
                                <div class="w-full h-full p-6 flex flex-col items-start bg-white">
                                    <img src="" data-src="{{ site.link }}/wp-content/uploads/2026/11/check-double-duotone-solid-full-1-1.png" class="w-10 h-10 block mb-2 lazyload">
                                    {% if item.title %}<span class="font-semibold text-lg mb-2 leading-tight">{{ item.title }}</span>{% endif %}
                                    <span class="">{{ item.copy }}</span>
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                {% endif %}
                {% if section.button %}
                    <div class="flex flex-wrap gap-y-3 gap-x-6 mt-8 items-center">
                        {% include "_atoms/button.twig" with {
                            link: section.button.url,
                            text: section.button.title,
                            colour: 'primary',
                            classes: '',
                        } %}
                        {% if section.button_disclaimer %}<span class="text-sm">{{ section.button_disclaimer }}</span>{% endif %}
                    </div>
                {% endif %}
            </div>
            {% if section.below_boxes %}
                <div class="flex flex-wrap justify-center -m-2 mt-8">
                    {% for item in section.below_boxes %}
                        <div class="w-full p-2 flex-grow {{ section.process|length is odd ? 'sm:w-1/2 md:w-1/3 xl:w-1/5' : 'sm:w-1/2 lg:w-1/4' }}">
                            <div class="w-full h-full p-6 pb-0 flex flex-col items-start bg-primary-pale">
                                {% if item.title %}<span class="font-semibold text-lg mb-2 leading-tight text-primary">{{ item.title }}</span>{% endif %}
                                <span class="copy light-copy">{{ item.copy }}</span>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            {% endif %}
        </div>
    </div>
</div>