{% set cta = section %}
<div class="container flex justify-center {{ section.padding_top ? spacingT }} {{ section.padding_bottom ? spacingB }}">
    <div class="p-6 md:p-10 bg-{{ backgroundColour ? backgroundColour : 'secondary-pale' }} flex flex-col relative transform transition-all hover:scale-103">
        {% if cta.pre_title %}<span class="mb-2 font-subheading text-2xl md:text-3xl text-primary">{{ cta.pre_title }}</span>{% endif %}
        {% if cta.title %}<span class="font-heading text-2xl md:text-3xl leading-tight {{ cta.copy ? 'mb-4' }} {{ cta.copy and not cta.pre_title ? 'text-primary' }}">{{ cta.title }}</span>{% endif %}
        {% if cta.copy %}<span class="">{{ cta.copy }}</span>{% endif %}
        {% if cta.link %}
            {% include "_atoms/button.twig" with {
                link: cta.link.url,
                text: cta.link.title,
                colour: button.colour,
                classes: 'mt-2 mr-2',
            } %}
        {% endif %}
    </div>
</div>