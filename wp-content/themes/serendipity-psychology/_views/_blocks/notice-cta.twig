{% set cta = section %}
<div class="container flex justify-center {{ section.padding_top ? spacingT }} {{ section.padding_bottom ? spacingB }}">
    <div class="relative flex flex-wrap {{ cta.image ? 'justify-start' : 'justify-center' }} max-w-screen-md rounded-tr-3xl overflow-hidden">
        {# <div class="block bg-{{ backgroundColour ? backgroundColour : 'secondary-pale' }} w-screen h-2 absolute left-1/2 -translate-x-1/2 top-1/2 -translate-y-1/2 z-0"></div> #}
        <div class="relative z-10 {{ cta.image ? 'w-full sm:w-2/3' }} p-6 md:p-10 bg-{{ backgroundColour ? backgroundColour : 'secondary-pale' }} flex flex-col relative">
            {% if cta.pre_title %}<span class="mb-2 font-subheading text-2xl md:text-3xl text-primary">{{ cta.pre_title }}</span>{% endif %}
            {% if cta.title %}<span class="font-heading text-2xl md:text-3xl leading-tight {{ cta.copy and not cta.pre_title ? 'text-primary' }}">{{ cta.title }}</span>{% endif %}
            {% if cta.copy %}<span class="">{{ cta.copy }}</span>{% endif %}
            {% if cta.link %}
                {% include "_atoms/button.twig" with {
                    link: cta.link.url,
                    text: cta.link.title,
                    colour: button.colour,
                    classes: 'mt-2 mr-2',
                } %}
            {% endif %}
        </div>
        {% if cta.image %}
            {% include "_atoms/picture.twig" with {
                source: cta.image.url,
                pictureClasses: 'relative z-10 w-full sm:w-1/3 relative z-0 sm:absolute top-0 right-0 sm:h-full',
                lazyload: true,
                breakpoints: {
                    "600px" : {
                        w: 480,
                        h: null,
                        crop: 'center'
                    },
                    "1px" : {
                        w: 480,
                        h: 200,
                        crop: 'center'
                    },
                },
                img: {
                    classes: 'w-full h-full object-center object-cover lazyload',
                    w: 480,
                    h: 200,
                    crop: 'center',
                    alt: cta.image.alt
                }
            } %}
        {% endif %}
    </div>
</div>